# ===========================================
# Proactive Personalized Agent System v2.0
# 环境变量配置
# ===========================================

# ===========================================
# OpenAI Compatible API
# ===========================================
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# ===========================================
# 服务器配置
# ===========================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# 调试模式 (true/false)
# 开启后任务调度器使用更短的间隔
DEBUG=false

# ===========================================
# 搜索配置
# ===========================================
# Serper (可选，付费服务)
SERPER_API_KEY=

# Jina AI Reader API (可选，用于网页抓取)
JINA_API_KEY=

# 是否优先使用 Serper (true/false)
# 如果为 false，则优先使用 DuckDuckGo
PREFER_SERPER=false

# ===========================================
# 日志配置
# ===========================================
# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# 是否将日志写入文件 (true/false)
LOG_TO_FILE=true

# 日志文件目录
LOG_DIR=logs

# 日志保留天数
LOG_RETENTION_DAYS=7

# ===========================================
# 任务调度配置 (秒)
# 以下为生产环境默认值，调试模式下会自动使用更短间隔
# ===========================================
# 主动搜索间隔 (默认 300 秒 = 5 分钟)
# PROACTIVE_SEARCH_INTERVAL=300

# 记忆验证间隔 (默认 600 秒 = 10 分钟)
# MEMORY_VALIDATION_INTERVAL=600

# 过期信息检查间隔 (默认 1800 秒 = 30 分钟)
# STALE_CHECK_INTERVAL=1800

# 空闲检查间隔 (默认 120 秒 = 2 分钟)
# IDLE_CHECK_INTERVAL=120

# 主动消息检查间隔 (默认 180 秒 = 3 分钟)
# INITIATIVE_CHECK_INTERVAL=180

# ===========================================
# 推送阈值配置
# ===========================================
# 阻塞式推送阈值 (0-100)
# PUSH_THRESHOLD_BLOCKING=70

# 通知式推送阈值 (0-100)
# PUSH_THRESHOLD_NOTIFY=40

# 用户空闲判定时间 (分钟)
# IDLE_THRESHOLD_MINUTES=5
